# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────
#
# Local Docker Postgres (docker-compose.yml): DATABASE_URL and DIRECT_URL
# are identical — there is no pooler to route around.
DATABASE_URL="postgresql://postgres:password@localhost:5432/marginflow?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/marginflow?schema=public"
#
# Supabase: DATABASE_URL is the pooled connection (Supavisor/PgBouncer,
# transaction mode, port 6543) — used by the running app (server/db.ts) and
# by `prisma generate`/`validate`. `pgbouncer=true` disables prepared-
# statement-reliant behavior the pooler's transaction mode can't support.
# DIRECT_URL is the direct connection (port 5432) — used only by
# `prisma migrate`/`db push`/`introspect`, which need session-level
# features (advisory locks, long-lived transactions) PgBouncer's
# transaction mode doesn't provide. Get both from
# Project Settings → Database → Connection string in the Supabase dashboard.
#
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Storage REST API (uploads) — Project Settings → API in the Supabase dashboard.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="[anon key]"

# ── Supabase Realtime (BROWSER / NEXT_PUBLIC) ───────────────────────────────
# REQUIRED for live updates (kitchen, orders, dashboard, notifications) without
# manual refresh. Next.js only inlines NEXT_PUBLIC_* vars into the client bundle,
# so the Realtime client (lib/supabase-realtime.ts) reads these — NOT SUPABASE_URL.
# On Vercel, set BOTH (they can share the same values as SUPABASE_URL/ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon key]"

# RS256 key pair used to sign/verify access tokens (see server/lib/auth/jwt.ts).
# ⚠️ GERE UM PAR ÚNICO POR AMBIENTE. NUNCA USE CHAVES DE EXEMPLO EM PRODUÇÃO —
# qualquer pessoa com a private key dummy pode forjar tokens de qualquer usuário.
# Gere com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Depois cole o conteúdo de cada PEM em UMA linha, trocando quebras reais por \n.
# Substitua os placeholders abaixo pelos valores REAIS gerados (não reuse exemplos):
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<COLE_AQUI_SUA_CHAVE_PRIVADA_GERADA_POR_AMBIENTE>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<COLE_AQUI_SUA_CHAVE_PUBLICA_GERADA_POR_AMBIENTE>\n-----END PUBLIC KEY-----"

# ── Marketplace integrations ───────────────────────────────────────────
# iFood (Merchant API)
IFOOD_CLIENT_ID="[iFood client id]"
IFOOD_CLIENT_SECRET="[iFood client secret]"
IFOOD_WEBHOOK_SECRET="[optional: shared secret for /api/webhooks/ifood verification]"

# 99Food (open API)
NINETYNINEFOOD_APP_ID="[99Food app_id]"
NINETYNINEFOOD_APP_SECRET="[99Food app_secret]"
NINETYNINEFOOD_WEBHOOK_SECRET="[optional: shared secret for /api/webhooks/99food verification]"
# NINETYNINEFOOD_BASE_URL="https://openapi.99food.com"
